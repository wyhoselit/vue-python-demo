
groups:
- name: API-Alerts
  rules:
  - alert: HighResponseTime
    expr: http_server_requests_seconds_sum{job="fastapi-backend"} / http_server_requests_seconds_count{job="fastapi-backend"} > 0.5
    for: 1m
    labels:
      severity: "page"
    annotations:
      summary: "High response time on {{ $labels.instance }}"
      description: "The average response time is greater than 500ms for over 1 minute."

