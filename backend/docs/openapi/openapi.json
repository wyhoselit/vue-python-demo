            "title": "Max Tokens",
            "default": 1000
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "messages",
          "model"
        ],
        "title": "ChatRequest"
      },
      "DashboardStats": {
        "properties": {
          "total_users": {
            "type": "integer",
            "title": "Total Users"
          },
          "active_sessions": {
            "type": "integer",
            "title": "Active Sessions"
          },
          "api_calls_24h": {
            "type": "integer",
            "title": "Api Calls 24H"
          }
        },
        "type": "object",
        "required": [
          "total_users",
          "active_sessions",
          "api_calls_24h"
        ],
        "title": "DashboardStats"
      },
      "EmbeddingRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "model": {
            "type": "string",
            "title": "Model"
          }
        },
        "type": "object",
        "required": [
          "text",
          "model"
        ],
        "title": "EmbeddingRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RAGQueryRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "n_results": {
            "type": "integer",
            "title": "N Results",
            "default": 5
          },
          "temperature": {
            "type": "number",
            "title": "Temperature",
            "default": 0.7
          },
          "max_tokens": {
            "type": "integer",
            "title": "Max Tokens",
            "default": 1000
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "query",
          "model"
        ],
        "title": "RAGQueryRequest"
      },
      "RealtimeDataPoint": {
        "properties": {
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "requests": {
            "type": "integer",
            "title": "Requests"
          },
          "avgResponseTime": {
            "type": "number",
            "title": "Avgresponsetime"
          },
          "status2xx": {
            "type": "integer",
            "title": "Status2Xx"
          },
          "status4xx": {
            "type": "integer",
            "title": "Status4Xx"
          },
          "status5xx": {
            "type": "integer",
            "title": "Status5Xx"
          },
          "activeUsers": {
            "type": "integer",
            "title": "Activeusers"
          }
        },
        "type": "object",
        "required": [
          "timestamp",
          "requests",
          "avgResponseTime",
          "status2xx",
          "status4xx",
          "status5xx",
          "activeUsers"
        ],
        "title": "RealtimeDataPoint"
      },
      "UserOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
